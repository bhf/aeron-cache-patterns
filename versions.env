# Single source of truth for the Aeron Cache release that every pattern deploys.
#
# Patterns pull public images from ghcr.io/<GHCR_OWNER>/aeroncache-* — this repo never
# builds images. Bumping the release is a one-line change here (one PR), picked up by
# every pattern Makefile and by CI.
#
# NOTE: upstream's publish-ghcr workflow strips the leading "v" from the release tag, so
# release v0.0.46-SNAPSHOT is published to GHCR as the image tag "0.0.46-SNAPSHOT".
# common/ghcr.mk derives the GHCR tag from AERONCACHE_VERSION by stripping that "v".
#
# This file is both Make-includable and shell-sourceable (plain KEY=value, no spaces).

AERONCACHE_VERSION=v0.0.49-SNAPSHOT
GHCR_OWNER=bhf
GHCR_REGISTRY=ghcr.io

# Aeron-gateway exerciser image (used only by the aeron-gateway pattern's verify, to drive a real
# SBE-over-Aeron round-trip against the gateway). This is the aeron-sample from bhf/aeron-cache-embedded
# published as a container image; it is versioned independently of AERONCACHE_VERSION.
AERON_SAMPLE_IMAGE=ghcr.io/bhf/aeroncache-embedded-aeron-sample
AERON_SAMPLE_TAG=latest
