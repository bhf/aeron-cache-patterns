{
  "title": "Aeron Cache Patterns - WebSocket keyed vs whole-cache",
  "uid": "aeroncache-routing-ws-keyed",
  "schemaVersion": 39,
  "editable": true,
  "tags": [
    "aeroncache",
    "aeron-cache-patterns"
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Scrape targets up",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "count(up{job=~\"aeroncache.*\"} == 1)", "legendFormat": "up", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [ { "color": "green", "value": null } ] }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": [ "lastNotNull" ] }
      }
    },
    {
      "type": "stat",
      "title": "Operations / sec",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "sum(rate(aeroncache_operations_total[1m]))", "legendFormat": "ops", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [ { "color": "green", "value": null } ] }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": [ "lastNotNull" ] }
      }
    },
    {
      "type": "stat",
      "title": "Active subscriptions",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(aeroncache_subscriptions_active)", "legendFormat": "subs", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [ { "color": "green", "value": null } ] }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": [ "lastNotNull" ] }
      }
    },
    {
      "type": "stat",
      "title": "Warm near caches (NEAR_CACHE=true)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "sum(aeroncache_near_warm_caches{domain=\"cache\"})", "legendFormat": "warm", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [ { "color": "green", "value": null } ] }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": [ "lastNotNull" ] }
      }
    },
    {
      "type": "timeseries",
      "title": "Operations / sec by gateway",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 10, "showPoints": "never" } }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        { "expr": "sum by (instance) (rate(aeroncache_operations_total[1m]))", "legendFormat": "{{instance}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Active subscriptions by gateway",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "showPoints": "never" } }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        { "expr": "sum by (instance) (aeroncache_subscriptions_active)", "legendFormat": "{{instance}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Active subscriptions by gateway and type",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "showPoints": "never" } }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        { "expr": "sum by (instance, type) (aeroncache_subscriptions_active)", "legendFormat": "{{instance}} {{type}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "JVM heap used by gateway",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10, "showPoints": "never" } }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        { "expr": "sum by (app) (jvm_memory_used_bytes{jvm_memory_type=\"heap\"})", "legendFormat": "{{app}}", "refId": "A" }
      ]
    }
  ]
}
