---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPatternsBySection, SECTION_INTROS } from '../lib/patterns';

const sections = await getPatternsBySection();
const total = sections.reduce((n, s) => n + s.categories.reduce((m, c) => m + c.patterns.length, 0), 0);
---

<BaseLayout>
  <section class="mx-auto max-w-content px-5 pt-16">
    <p class="mb-4 text-xs font-semibold uppercase tracking-[0.35em] text-sage-400">Reference patterns</p>
    <h1 class="max-w-3xl text-balance text-4xl font-semibold tracking-tight text-ink sm:text-5xl">
      Proven ways to build with <span class="text-sage-400">Aeron Cache</span>
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink/70">
      A growing collection of self-contained, runnable patterns. Each one is documented, tested in CI, and ready to
      try with a single command.
    </p>
    <p class="mt-3 font-mono text-xs text-ink/50">{total} pattern{total === 1 ? '' : 's'}</p>
  </section>

  <section class="mx-auto max-w-content px-5 py-12">
    {sections.map((s) => (
      <div class="mt-16 first:mt-0">
        <h2 class="text-2xl font-semibold tracking-tight text-ink">{s.section}</h2>
        {SECTION_INTROS[s.section] ? (
          <p class="mb-8 mt-3 max-w-2xl leading-relaxed text-ink/65" set:html={SECTION_INTROS[s.section]} />
        ) : (
          <div class="mb-8" />
        )}
        {s.categories.map((g) => (
      <div class="mt-10 first:mt-0">
        <h3 class="mb-5 border-b border-white/10 pb-2 text-sm font-semibold uppercase tracking-widest text-ink/50">
          {g.category}
        </h3>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {g.patterns.map((p) => (
            <a
              href={`/patterns/${p.slug}`}
              class="group flex flex-col rounded-xl border border-white/10 bg-white/[0.03] p-5 transition hover:border-sage-600/50 hover:bg-white/[0.05]"
            >
              <div class="flex items-center justify-between gap-2">
                <h4 class="text-lg font-semibold text-ink transition group-hover:text-sage-300">{p.title}</h4>
                <span
                  class:list={[
                    'shrink-0 rounded-full px-2 py-0.5 text-[0.65rem] font-medium uppercase tracking-wide',
                    p.status === 'ready' ? 'bg-sage-600/20 text-sage-300' : 'bg-white/10 text-ink/50',
                  ]}
                >
                  {p.status}
                </span>
              </div>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink/65">{p.summary}</p>
              {p.difficulty && (
                <p class="mt-3 font-mono text-[0.7rem] uppercase tracking-wide text-ink/40">{p.difficulty}</p>
              )}
            </a>
          ))}
        </div>
      </div>
        ))}
      </div>
    ))}

    {total === 0 && (
      <p class="rounded-xl border border-white/10 bg-white/[0.03] p-6 text-ink/60">
        No patterns yet. Scaffold one with <code class="font-mono text-sage-300">scripts/new-pattern.sh</code>.
      </p>
    )}
  </section>
</BaseLayout>
