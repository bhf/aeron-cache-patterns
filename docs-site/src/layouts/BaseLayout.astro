---
import '../styles/tailwind.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Aeron Cache Patterns',
  description = 'Self-contained Kubernetes deployment patterns for Aeron Cache — run each with one command.',
} = Astro.props;

const pageTitle = title.includes('Aeron Cache Patterns') ? title : `${title} · Aeron Cache Patterns`;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0f0d" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>

  <body class="min-h-screen bg-base-900 text-ink font-sans antialiased selection:bg-sage-600/40 flex flex-col">
    <nav class="sticky top-0 z-50 border-b border-white/10 bg-base-900/80 backdrop-blur-md">
      <div class="mx-auto flex max-w-content items-center justify-between gap-4 px-5 py-3">
        <a href="/" class="group flex items-center gap-2 whitespace-nowrap">
          <span class="text-sm font-light uppercase tracking-[0.25em] text-ink transition group-hover:text-sage-300">
            Aeron&nbsp;Cache <span class="text-sage-400">Patterns</span>
          </span>
        </a>
      </div>
    </nav>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="sticky bottom-0 z-40 mt-16 border-t border-white/10 bg-base-900/70 backdrop-blur-md">
      <div class="mx-auto flex max-w-content flex-wrap items-center justify-center gap-x-6 gap-y-2 px-5 py-4 font-mono text-xs text-ink/60">
        <a href="https://aeron-cache.pages.dev" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 transition hover:text-sage-300">
          <img src="/favicon.ico" width="16" height="16" alt="" aria-hidden="true" class="h-4 w-4 shrink-0 object-contain" />
          <span>Aeron Cache</span>
        </a>
        <span class="text-ink/30">·</span>
        <a href="https://github.com/bhf/aeron-cache-patterns" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 transition hover:text-sage-300">
          <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" fill="currentColor"
            ><path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            ></path></svg
          >
          <span>bhf/aeron-cache-patterns</span>
        </a>
      </div>
    </footer>

    <style is:global>
      body {
        background-image:
          linear-gradient(rgba(244, 246, 244, 0.02) 1px, transparent 1px),
          linear-gradient(90deg, rgba(244, 246, 244, 0.02) 1px, transparent 1px),
          radial-gradient(120% 80% at 50% -10%, rgba(95, 158, 120, 0.08) 0%, rgba(11, 15, 13, 0) 55%),
          linear-gradient(180deg, rgba(11, 15, 13, 0) 0%, rgba(11, 15, 13, 0.6) 100%);
        background-size: 40px 40px, 40px 40px, auto, auto;
      }

      /* Code blocks (Shiki) blend into the dark surface instead of a flat grey box. */
      pre.astro-code,
      pre:has(> code) {
        background: rgba(8, 12, 10, 0.75) !important;
        border: 1px solid rgba(244, 246, 244, 0.1);
        border-radius: 0.75rem;
        padding: 1rem 1.15rem;
        overflow-x: auto;
        font-size: 0.85rem;
        line-height: 1.6;
      }

      /* Mermaid: hide the raw ```mermaid source until the client renderer swaps it for a diagram. */
      pre:has(> code.language-mermaid) {
        display: none;
      }
      .mermaid {
        display: flex;
        justify-content: center;
        margin: 1.5rem 0;
      }
      .mermaid[data-processed] {
        position: relative;
        padding: 1rem 1.15rem;
        border: 1px solid rgba(244, 246, 244, 0.1);
        border-radius: 0.75rem;
        background: rgba(8, 12, 10, 0.5);
        overflow-x: auto;
        cursor: zoom-in;
        transition: border-color 0.15s ease;
      }
      .mermaid[data-processed]:hover,
      .mermaid[data-processed]:focus-visible {
        border-color: rgba(95, 158, 120, 0.5);
        outline: none;
      }
      .mermaid svg {
        max-width: 100%;
        height: auto;
      }
      /* Per-diagram controls (Enlarge / New tab), shown on hover/focus. */
      .mmd-tools {
        position: absolute;
        top: 0.5rem;
        right: 0.6rem;
        display: flex;
        gap: 0.35rem;
        opacity: 0;
        transition: opacity 0.15s ease;
      }
      .mermaid[data-processed]:hover .mmd-tools,
      .mermaid[data-processed]:focus-within .mmd-tools { opacity: 1; }
      .mmd-tools button {
        font-size: 0.68rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        color: rgba(184, 216, 192, 0.95);
        background: rgba(8, 12, 10, 0.78);
        border: 1px solid rgba(95, 158, 120, 0.35);
        border-radius: 0.4rem;
        padding: 0.12rem 0.45rem;
        cursor: pointer;
        transition: all 0.15s ease;
      }
      .mmd-tools button:hover { color: #d4e6d8; border-color: rgba(95, 158, 120, 0.7); background: rgba(8, 12, 10, 0.95); }

      /* Diagram modal (click a diagram to enlarge). */
      .mmd-modal[hidden] { display: none; }
      .mmd-modal {
        position: fixed;
        inset: 0;
        z-index: 100;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
      }
      .mmd-modal-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(5, 8, 6, 0.82);
        backdrop-filter: blur(4px);
      }
      .mmd-modal-dialog {
        position: relative;
        /* An explicit width so the diagram scales UP to fill it (without it, the dialog
           shrink-wraps to the SVG's natural size and "enlarge" does nothing). */
        width: min(94vw, 1300px);
        max-height: 92vh;
        overflow: auto;
        background: rgba(15, 21, 18, 0.96);
        border: 1px solid rgba(244, 246, 244, 0.12);
        border-radius: 0.9rem;
        padding: 2.25rem 1.5rem 1.5rem;
        box-shadow: 0 24px 70px rgba(0, 0, 0, 0.55);
      }
      .mmd-modal-body { display: block; }
      .mmd-modal-body svg {
        max-width: none;
        width: 100%;
        height: auto;
      }
      .mmd-modal-close {
        position: absolute;
        top: 0.5rem;
        right: 0.6rem;
        width: 2rem;
        height: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        line-height: 1;
        color: rgba(244, 246, 244, 0.7);
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(244, 246, 244, 0.12);
        border-radius: 0.5rem;
        cursor: pointer;
        transition: all 0.15s ease;
      }
      .mmd-modal-close:hover { color: #b8d8c0; border-color: rgba(95, 158, 120, 0.5); }
    </style>

    <!-- Render ```mermaid blocks into themed diagrams (Shiki skips them; see astro.config). -->
    <script>
      import mermaid from 'mermaid';

      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'loose',
        theme: 'base',
        themeVariables: {
          fontFamily: 'ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, sans-serif',
          fontSize: '14px',
          background: 'transparent',
          primaryColor: '#141b17',
          primaryBorderColor: '#5f9e78',
          primaryTextColor: '#f4f6f4',
          secondaryColor: '#0f1512',
          secondaryBorderColor: '#47785c',
          secondaryTextColor: '#d4e6d8',
          tertiaryColor: '#0f1512',
          tertiaryBorderColor: '#2a3a30',
          tertiaryTextColor: '#f4f6f4',
          lineColor: '#9db89f',
          textColor: '#d4e6d8',
          clusterBkg: 'rgba(95, 158, 120, 0.06)',
          clusterBorder: 'rgba(95, 158, 120, 0.3)',
          edgeLabelBackground: '#0b0f0d',
          nodeBorder: '#5f9e78',
        },
      });

      // Serialize a rendered diagram SVG into a standalone dark-background HTML page, so it stays
      // readable when opened on its own (the diagram text is light on transparent).
      function diagramPageUrl(svg) {
        const clone = svg.cloneNode(true);
        // Strip width/height/style so the wrapper's explicit dimensions take over. An SVG with only
        // a viewBox has no definite size on its own page and collapses — give it a real viewport and
        // let preserveAspectRatio scale the diagram to fit.
        clone.removeAttribute('style');
        clone.removeAttribute('width');
        clone.removeAttribute('height');
        const svgStr = new XMLSerializer().serializeToString(clone);
        const html =
          '<!doctype html><meta charset="utf-8"><title>Diagram</title>' +
          '<style>html,body{margin:0;height:100%;background:#0b0f0d}' +
          'svg{display:block;width:96vw;height:92vh;margin:4vh auto}</style>' + svgStr;
        return URL.createObjectURL(new Blob([html], { type: 'text/html' }));
      }

      function openInNewTab(svg) {
        const url = diagramPageUrl(svg);
        window.open(url, '_blank', 'noopener');
        setTimeout(() => URL.revokeObjectURL(url), 60000);
      }

      // One shared modal, built lazily.
      let modal, modalBody, lastTrigger;
      function buildModal() {
        modal = document.createElement('div');
        modal.className = 'mmd-modal';
        modal.hidden = true;
        modal.innerHTML =
          '<div class="mmd-modal-backdrop"></div>' +
          '<div class="mmd-modal-dialog" role="dialog" aria-modal="true" aria-label="Diagram">' +
          '<button class="mmd-modal-close" aria-label="Close diagram">×</button>' +
          '<div class="mmd-modal-body"></div></div>';
        modalBody = modal.querySelector('.mmd-modal-body');
        const close = () => closeModal();
        modal.querySelector('.mmd-modal-backdrop').addEventListener('click', close);
        modal.querySelector('.mmd-modal-close').addEventListener('click', close);
        document.body.appendChild(modal);
      }
      function openModal(svg, trigger) {
        if (!modal) buildModal();
        lastTrigger = trigger || null;
        const clone = svg.cloneNode(true);
        clone.removeAttribute('style'); // drop the inline max-width cap so it fills the modal
        clone.setAttribute('width', '100%');
        clone.removeAttribute('height');
        modalBody.replaceChildren(clone);
        modal.hidden = false;
        modal.querySelector('.mmd-modal-close').focus();
      }
      function closeModal() {
        if (!modal || modal.hidden) return;
        modal.hidden = true;
        modalBody.replaceChildren();
        if (lastTrigger && lastTrigger.focus) lastTrigger.focus();
      }
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

      const blocks = document.querySelectorAll('pre > code.language-mermaid');
      if (blocks.length) {
        blocks.forEach((code) => {
          const pre = code.parentElement;
          const div = document.createElement('div');
          div.className = 'mermaid';
          div.textContent = code.textContent || '';
          pre && pre.replaceWith(div);
        });

        mermaid.run({ nodes: document.querySelectorAll('div.mermaid') }).then(() => {
          document.querySelectorAll('.mermaid[data-processed]').forEach((el) => {
            const svg = el.querySelector('svg');
            if (!svg) return;

            // Clicking the diagram (or Enter/Space when focused) opens the modal.
            el.setAttribute('role', 'button');
            el.setAttribute('tabindex', '0');
            el.setAttribute('aria-label', 'Enlarge diagram');
            el.addEventListener('click', (e) => {
              if (e.target.closest('.mmd-tools')) return; // let the buttons handle themselves
              openModal(svg, el);
            });
            el.addEventListener('keydown', (e) => {
              if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openModal(svg, el); }
            });

            // Explicit Enlarge / New tab controls.
            const tools = document.createElement('div');
            tools.className = 'mmd-tools';
            const enlarge = document.createElement('button');
            enlarge.type = 'button';
            enlarge.textContent = '⤢ enlarge';
            enlarge.addEventListener('click', (e) => { e.stopPropagation(); openModal(svg, el); });
            const newtab = document.createElement('button');
            newtab.type = 'button';
            newtab.textContent = '↗ new tab';
            newtab.addEventListener('click', (e) => { e.stopPropagation(); openInNewTab(svg); });
            tools.append(enlarge, newtab);
            el.appendChild(tools);
          });
        });
      }
    </script>
  </body>
</html>
